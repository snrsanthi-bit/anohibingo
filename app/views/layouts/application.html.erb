<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>2人用ビンゴ</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8" />

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
     <%= javascript_importmap_tags %>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Gochi+Hand&display=swap" rel="stylesheet"/>

    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#1152d4",
              "background-light": "#fbfbf9",
              "background-dark": "#101622",
            },
            fontFamily: {
              display: ["Spline Sans", "sans-serif"],
              hand: ["Gochi Hand", "cursive"]
            },
            borderRadius: {
              DEFAULT: "1rem",
              lg: "2rem",
              xl: "3rem",
              full: "9999px"
            },
          },
        },
      }
    </script>

    <style>
      .sketch-border {
        border: 2px solid #1152d4;
        border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
      }
      .sketch-border-thick {
        border: 3px solid #1152d4;
        border-radius: 255px 25px 225px 25px / 25px 225px 25px 255px;
      }
      .bg-grid {
        background-image: radial-gradient(#d1d5db 0.5px, transparent 0.5px);
        background-size: 20px 20px;
      }
      .hand-drawn-font {
        font-family: 'Spline Sans', sans-serif;
        letter-spacing: -0.02em;
      }
      body {
        min-height: max(884px, 100dvh);
      }
      .paper-texture {
        background-color: #fdfdfd;
        background-image: 
          linear-gradient(rgba(17, 82, 212, 0.1) 1px, transparent 1px),
          linear-gradient(90deg, rgba(17, 82, 212, 0.1) 1px, transparent 1px);
        background-size: 20px 20px;
      }

      .hand-drawn-border {
        border: 2px solid #1e293b;
        border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
      }

      .scribble-circle {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 80%;
        height: 80%;
        border: 3px solid #1152d4;
        border-radius: 50% 45% 55% 48% / 48% 52% 45% 55%;
        opacity: 0.7;
      }

      .scribble-x::before,
      .scribble-x::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 80%;
        height: 3px;
        background-color: #64748b;
        transform-origin: center;
      }

      .scribble-x::before {
        transform: translate(-50%, -50%) rotate(42deg);
      }

      .scribble-x::after {
        transform: translate(-50%, -50%) rotate(-48deg);
      }
    </style>
  </head>

  <body class="bg-background-light dark:bg-background-dark font-display text-[#111318] dark:text-white min-h-screen ">
    <%= yield %>
  </body>
</html>