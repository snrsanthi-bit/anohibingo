<p>ルームコード: <%= @room.code %></p>

<% player = current_player(@room) %>

<% if @room.waiting? %>
  <div class="text-center space-y-4">
    <p>対戦相手を待っています...</p>

    <div class="bg-gray-100 p-3 rounded">
      <%= room_url(@room.code) %>
    </div>

    <button onclick="copyLink()" class="btn">
      リンクをコピー
    </button>
  </div>

  <script>
    function copyLink() {
      navigator.clipboard.writeText("<%= room_url(@room.code) %>");
      alert("リンクをコピーしました！");
    }

    setTimeout(() => location.reload(), 3000);
  </script>
 <% end %>