    <!-- ターン表示 -->
  <div class="turn-wrapper">
    <div class="turn-box <%= @game.current_turn %>">
      <% if @game.current_turn == @player %>
        あなたの番です
      <% else %>
        相手の番です
      <% end %>
    </div>
  </div>

  <!-- 自分の盤面 -->
<div  class="max-w-md mx-auto">   
 <div class="paper-texture hand-drawn-border p-4 shadow-sm relative overflow-hidden">
  <div class="grid grid-cols-5 gap-0">
    <% @game.board_for(@player).each_with_index do |row, row_index| %>
      <% row.each_with_index do |number, col_index| %>
        <%= button_to declare_multiplayer_game_path(@game, number: number),
                      method: :post,
                      form: { class: "contents" },
                      class: "relative w-full h-24 flex items-center justify-center border-ink/20
                              #{'border-r' unless col_index == 4}
                              #{'border-b' unless row_index == 4}
                              bg-transparent p-0",
                      disabled: (@game.current_turn != @player) do %>

          <span class="font-hand text-3xl">
            <%= "%02d" % number %>
          </span>

          <% if @game.marks_for(@player).include?(number) %>
            <div class="scribble-circle"></div>
          <% elsif @game.obstacles_for(@player).include?(number) %>
            <div class="scribble-x"></div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    </div>
  </div>
</div>

  <!-- 勝敗表示 -->
  <% if @game.winner == "draw" %>
    <h2>DRAW!</h2>
  <% elsif @game.winner.present? %>
    <h2>
      <%= @game.winner == @player ? "YOU WIN!" : "YOU LOSE!" %>
    </h2>
  <% end %>

  <% unless @game.winner.present? %>
    <script>
      setTimeout(function() {
        window.location.reload();
      }, 3000);
    </script>
  <% end %>
<% if @game&.winner.present? %>
  <script>
    window.location.href = "<%= result_multiplayer_game_path(@game) %>";
  </script>
<% end %>