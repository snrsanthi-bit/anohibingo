<h2>あなたの盤面</h2>

<% @game.player_board.each do |row| %>
  <div>
    <% row.each do |number| %>

      <% if @game.player_marks.include?(number) %>
        <span style="margin-right: 10px; color:red;">
          <%= number %>
        </span>

      <% elsif @game.declared_numbers.include?(number) %>
        <span style="margin-right: 10px; color: gray;">
          <%= number %>
        </span>

      <% else %>
        <%= button_to number, mark_path(number: number), method: :post %>
      <% end %>

    <% end %>
  </div>
<% end %>

<%= button_to "リセット", reset_path, method: :post %>

<% if @game.winner == "draw" %>
  <h2>DRAW!</h2>
<% elsif @game.winner %>
  <h2><%= @game.winner.upcase %> WIN!</h2>
<% end %>

<h2>相手の盤面（デバッグ表示）</h2>

<% @game.opponent_board.each do |row| %>
  <div>
    <% row.each do |number| %>

      <% if @game.opponent_marks.include?(number) %>
        <span style="margin-right: 10px; color:blue;">
          <%= number %>
        </span>

      <% elsif @game.declared_numbers.include?(number) %>
        <span style="margin-right: 10px; color: gray;">
          <%= number %>
        </span>

      <% else %>
        <span style="margin-right: 10px;">
          <%= number %>
        </span>
      <% end %>

    <% end %>
  </div>
<% end %>