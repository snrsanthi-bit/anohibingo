<main class="relative min-h-screen w-full overflow-hidden p-6">

  <!-- Background Doodles -->
  <div class="absolute top-10 right-10 opacity-20 rotate-12">
    <span class="material-symbols-outlined text-6xl text-primary">
      grid_4x4
    </span>
  </div>

  <div class="absolute bottom-20 left-10 opacity-20 -rotate-12">
    <span class="material-symbols-outlined text-7xl text-primary">
      edit
    </span>
  </div>

  <div class="absolute top-1/4 left-5 opacity-10">
    <span class="material-symbols-outlined text-4xl text-primary">
      auto_awesome
    </span>
  </div>

  <div class="absolute top-20 left-20 opacity-20 rotate-45">
    <span class="material-symbols-outlined text-8xl text-primary">
      gesture
    </span>
  </div>

  <div class="absolute bottom-10 right-20 opacity-20 -rotate-12">
    <span class="material-symbols-outlined text-9xl text-primary">
      draw
    </span>
  </div>

  <!-- Game -->
  <div class="relative z-10 mx-auto max-w-xl">

    <div class="paper-texture p-6 shadow-md">

      <div class="turn-wrapper">
        <div class="turn-box <%= @game.current_turn %>">
          <% if @game.current_turn == "player" %>
            あなたの番
          <% else %>
            相手の番
          <% end %>
        </div>
      </div>

<div class="max-w-md mx-auto">
  <div class="paper-texture hand-drawn-border p-4 shadow-sm relative overflow-hidden">
    <div class="grid grid-cols-5 gap-0">

      <% @game.player_board.each_with_index do |row, row_index| %>
        <% row.each_with_index do |number, col_index| %>

          <% if @game.player_marks.include?(number) %>

            <div class="relative w-full h-24 flex items-center justify-center border-ink/20
                        <%= 'border-r' unless col_index == 4 %>
                        <%= 'border-b' unless row_index == 4 %>
                        bg-transparent p-0">

              <span class="font-hand text-3xl">
                <%= "%02d" % number %>
              </span>

              <div class="scribble-circle"></div>
            </div>

          <% elsif @game.player_obstacles.include?(number) %>

            <div class="relative w-full h-24 flex items-center justify-center border-ink/20
                        <%= 'border-r' unless col_index == 4 %>
                        <%= 'border-b' unless row_index == 4 %>
                        bg-transparent p-0">

              <span class="font-hand text-3xl">
                <%= "%02d" % number %>
              </span>

              <div class="scribble-x"></div>
            </div>

          <% else %>

            <%= button_to mark_path(number: number),
                          method: :post,
                          form: { class: "contents" },
                          class: "relative w-full h-24 flex items-center justify-center border-ink/20
                                  #{'border-r' unless col_index == 4}
                                  #{'border-b' unless row_index == 4}
                                  bg-transparent p-0" do %>

              <span class="font-hand text-3xl">
                <%= "%02d" % number %>
              </span>

              <% end %>
            <% end %>

          <% end %>
        <% end %>
      </div>


     </div>
      <%=link_to root_path, class: "block w-full mt-4 py-4 text-2xl font-black bg-primary text-white hand-drawn-border border-primary shadow-[4px_4px_0px_0px_rgba(17,82,212,0.3)] hover:translate-y-1 hover:shadow-none transition-all duration-75 text-center" do %>
                    もうやめる！！
                <% end %>
  </div>

</main>