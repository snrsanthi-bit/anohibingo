<div class="turn-wrapper">
  <div class="turn-box <%= @game.current_turn %>">
    <% if @game.current_turn == "player" %>
      あなたの番
    <% else %>
      相手の番
    <% end %>
  </div>
</div>
<div class="board">
  <% @game.player_board.each do |row| %>
    <% row.each do |number| %>

      <% if @game.player_marks.include?(number) %>
        <div class="cell player-mark">
          <%= number %>
        </div>

      <% elsif @game.player_obstacles.include?(number) %>
        <div class="cell opponent-mark">
          <%= number %>
        </div>

      <% else %>
        <%= button_to mark_path(number: number),
                      method: :post,
                      class: "cell cell-button" do %>
          <%= number %>
        <% end %>
      <% end %>

    <% end %>
  <% end %>
</div>

<div class="center">
  <%= button_to "もう一度遊ぶ", reset_path, method: :post, class: "reset-btn" %>
</div>

<% if @game.winner == "draw" %>
  <h2>DRAW!</h2>
<% elsif @game.winner %>
  <h2><%= @game.winner.upcase %> WIN!</h2>
<% end %>

<h2>相手の盤面（デバッグ表示）</h2>

<% @game.opponent_board.each do |row| %>
  <div>
    <% row.each do |number| %>

      <% if @game.opponent_marks.include?(number) %>
        <span style="margin-right: 10px; color:blue;">
          <%= number %>
        </span>

      <% elsif @game.opponent_obstacles.include?(number) %>
        <span style="margin-right: 10px; color: red;">
          <%= number %>
        </span>

      <% else %>
        <span style="margin-right: 10px;">
          <%= number %>
        </span>
      <% end %>

    <% end %>
  </div>
<% end %>