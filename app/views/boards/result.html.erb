<!-- Background Doodles -->
<div class="absolute top-10 right-10 opacity-20 rotate-12">
<span class="material-symbols-outlined text-6xl text-primary">grid_4x4</span>
</div>
<div class="absolute bottom-20 left-10 opacity-20 -rotate-12">
<span class="material-symbols-outlined text-7xl text-primary">edit</span>
</div>
<div class="absolute top-1/4 left-5 opacity-10">
<span class="material-symbols-outlined text-4xl text-primary">auto_awesome</span>
</div>

<main class="relative flex h-auto min-h-screen w-full flex-col paper-texture overflow-x-hidden p-6 mx-auto max-w-xl md:py-12">

  <!-- タイトル -->
<div class="relative text-center mb-8">
  <h1 class="text-primary text-6xl font-black leading-tight tracking-tighter">
    
    <% if @game.winner == "player" %>
      あなたの勝ち！


    <% elsif @game.winner == "opponent" %>
      あなたの負け！
      <span class="block text-xl font-bold text-red-500 mt-2 tracking-widest uppercase">
        YOU LOSE...
      </span>

    <% elsif @game.winner == "draw" %>
      引き分け！
      <span class="block text-xl font-bold text-gray-500 mt-2 tracking-widest uppercase">
        DRAW
      </span>
    <% end %>

  </h1>
</div>

  <!-- ビンゴボード（仮固定） -->
  <div class="bg-white/80 backdrop-blur-sm p-4 rounded-xl shadow-sm border-2 border-primary/10 mb-10">

    <div class="grid grid-cols-5 gap-0">
  <% @game.player_board.each_with_index do |row, row_index| %>
    <% row.each_with_index do |number, col_index| %>

      <div class="relative w-full aspect-square flex items-center justify-center border-ink/20
                  <%= 'border-r' unless col_index == 4 %>
                  <%= 'border-b' unless row_index == 4 %>
                  bg-transparent">

        <span class="font-hand text-3xl">
          <%= "%02d" % number %>
        </span>

        <% if @game.player_marks.include?(number) %>
          <div class="scribble-circle"></div>

        <% elsif @game.player_obstacles.include?(number) %>
          <div class="scribble-x"></div>
        <% end %>

      </div>

    <% end %>
  <% end %>
</div>

  </div>

  <!-- ボタン -->
  <div class="flex flex-col gap-4 mt-auto">

    <%= button_to "もう一度遊ぶ", reset_path, method: :post, form_class: "w-full", class: "reset-btn w-full" %>

    <%= link_to "ホームへ戻る", root_path,
          class: "bg-primary/10 text-primary font-semibold py-4 rounded-full text-center" %>

  </div>

</main>